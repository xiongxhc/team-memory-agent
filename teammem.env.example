# Copy to ~/.config/teammem/hub.env  (chmod 600; dir chmod 700).
# Values are literal: absolute paths only, no ~ and no shell variables.
# Placeholders only — never commit a real token or a real URL here.

TEAMMEM_CONFIG_DIR=/absolute/path/to/config
TEAMMEM_DB=/absolute/path/to/ledger.db
TEAMMEM_VAULT=/absolute/path/to/team-vault

# Connector credentials — set only the ones enabled in connectors.yaml.
# TEAMMEM_GITHUB_TOKEN=<github-fine-grained-token>
# TEAMMEM_SLACK_BOT_TOKEN=<slack-bot-token>
# TEAMMEM_GITLAB_URL=https://gitlab.example.com
# TEAMMEM_GITLAB_TOKEN=<gitlab-read-api-token>
# TEAMMEM_GITLAB_GROUP=<group-id-or-path>
# TEAMMEM_FEISHU_APP_ID=<feishu-app-id>
# TEAMMEM_FEISHU_APP_SECRET=<feishu-app-secret>
# TEAMMEM_DISCORD_BOT_TOKEN=<discord-bot-token>

# Reviewed member bundles (optional, as one complete set).
# TEAMMEM_INBOX=/absolute/path/to/inbox
# TEAMMEM_ARCHIVE=/absolute/path/to/archive
# TEAMMEM_QUARANTINE=/absolute/path/to/quarantine
# TEAMMEM_SNAPSHOTS=/absolute/path/to/snapshots

# Meetings (optional, as one complete set). Setting any one of these makes all
# of them required. Every directory must be absolute, distinct, and outside both
# the vault and one another; teammem creates them at mode 0700 and refuses any
# that is group- or world-accessible, because bundles carry transcripts and the
# store carries encrypted recordings.
# TEAMMEM_MEETING_INBOX=/absolute/path/to/meeting-inbox
# TEAMMEM_MEETING_ARCHIVE=/absolute/path/to/meeting-archive
# TEAMMEM_MEETING_QUARANTINE=/absolute/path/to/meeting-quarantine
# TEAMMEM_MEETING_AUDIO_STORE=/absolute/path/to/meeting-audio
# TEAMMEM_MEETING_RECEIPTS=/absolute/path/to/meeting-receipts
# TEAMMEM_MEETING_ALERTS=/absolute/path/to/meeting-alerts
# How many days before the audio expiry an incomplete transcript is warned
# about, 0 to warn about nothing. Never extends retention. Default below.
# TEAMMEM_MEETING_WARN_DAYS=3
# Web root of the published vault. Absolute https, repository root only: no
# /-/blob/ path, no query, no fragment, no credentials. Receipts name a commit
# under it, so a wrong base is a link an organizer cannot open.
# TEAMMEM_VAULT_WEB_BASE=https://gitlab.example.com/team/team-vault
# The remote and ref a receipt's commit must reach. Defaults below.
# TEAMMEM_VAULT_REMOTE=origin
# TEAMMEM_VAULT_REF=refs/heads/main

# Synthesis (optional).
# ANTHROPIC_API_KEY=<anthropic-api-key>
# TEAMMEM_LLM_CONCURRENCY=2
# TEAMMEM_OBSIDIAN_PROJECTS=/absolute/path/to/obsidian/projects
# TEAMMEM_PUSH=0
