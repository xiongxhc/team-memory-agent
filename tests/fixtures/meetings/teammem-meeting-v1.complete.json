  "transcript": [
    {
      "segment_id": "s001",
      "started_at": "2026-09-02T14:00:05Z",
      "ended_at": "2026-09-02T14:00:35Z",
      "text": "Let us walk the Atlas launch checklist top to bottom before anything else.",
      "speaker": {"kind": "person", "person_id": "ou_ada", "display_name": "Ada Chen", "reconciled": true},
      "attribution_confidence": 0.94,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s002",
      "started_at": "2026-09-02T14:00:35Z",
      "ended_at": "2026-09-02T14:01:10Z",
      "text": "Atlas has two open packaging items and both have owners already.",
      "speaker": {"kind": "person", "person_id": "ou_ben", "display_name": "Ben Ortiz", "reconciled": true},
      "attribution_confidence": 0.91,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s003",
      "started_at": "2026-09-02T14:01:10Z",
      "ended_at": "2026-09-02T14:01:50Z",
      "text": "The staging soak has been green for six days, so I am comfortable with the current build.",
      "speaker": {"kind": "person", "person_id": "ou_chi", "display_name": "Chidi Okafor", "reconciled": true},
      "attribution_confidence": 0.88,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s004",
      "started_at": "2026-09-02T14:02:00Z",
      "ended_at": "2026-09-02T14:02:40Z",
      "text": "Borealis is blocked on the migration window, and we need one night of downtime.",
      "speaker": {"kind": "person", "person_id": "ou_dana", "display_name": "Dana Whitfield", "reconciled": true},
      "attribution_confidence": 0.93,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s005",
      "started_at": "2026-09-02T14:02:40Z",
      "ended_at": "2026-09-02T14:03:20Z",
      "text": "We can take that window on Thursday night; the read replicas absorb the traffic.",
      "speaker": {"kind": "person", "person_id": "ou_eli", "display_name": "Eli Novak", "reconciled": true},
      "attribution_confidence": 0.9,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s006",
      "started_at": "2026-09-02T14:03:20Z",
      "ended_at": "2026-09-02T14:04:00Z",
      "text": "Cygnus is mid-sprint and nothing in the launch depends on it this month.",
      "speaker": {"kind": "person", "person_id": "ou_fen", "display_name": "Fen Zhao", "reconciled": true},
      "attribution_confidence": 0.87,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s007",
      "started_at": "2026-09-02T14:04:10Z",
      "ended_at": "2026-09-02T14:04:50Z",
      "text": "Agreed, Cygnus stays on its current sprint plan and we revisit after launch.",
      "speaker": {"kind": "person", "person_id": "ou_gus", "display_name": "Gus Petrov", "reconciled": true},
      "attribution_confidence": 0.85,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s008",
      "started_at": "2026-09-02T14:05:00Z",
      "ended_at": "2026-09-02T14:05:30Z",
      "text": "One question on the rollback path, does it cover the schema change too?",
      "speaker": {"kind": "anonymous", "cluster_id": "spk_3"},
      "attribution_confidence": 0.42,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s009",
      "started_at": "2026-09-02T14:05:30Z",
      "ended_at": "2026-09-02T14:06:15Z",
      "text": "It does, but only for the first hour after the cutover.",
      "speaker": {"kind": "ambiguous"},
      "attribution_confidence": 0.31,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s010",
      "started_at": "2026-09-02T14:06:15Z",
      "ended_at": "2026-09-02T14:07:00Z",
      "text": "Then the Atlas go/no-go call moves to Friday morning so the soak keeps running.",
      "speaker": {"kind": "person", "person_id": "ou_ada", "display_name": "Ada Chen", "reconciled": true},
      "attribution_confidence": 0.95,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s011",
      "started_at": "2026-09-02T14:07:00Z",
      "ended_at": "2026-09-02T14:07:45Z",
      "text": "I will write the Borealis migration runbook and circulate it before Thursday.",
      "speaker": {"kind": "person", "person_id": "ou_dana", "display_name": "Dana Whitfield", "reconciled": true},
      "attribution_confidence": 0.92,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s012",
      "started_at": "2026-09-02T14:07:45Z",
      "ended_at": "2026-09-02T14:08:30Z",
      "text": "The packaging items land tomorrow, I already have both branches open.",
      "speaker": {"kind": "person", "person_id": "ou_ben", "display_name": "Ben Ortiz", "reconciled": true},
      "attribution_confidence": 0.89,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s013",
      "started_at": "2026-09-02T14:08:30Z",
      "ended_at": "2026-09-02T14:09:20Z",
      "text": "Someone should still review the Cygnus interface note, it has been open a while.",
      "speaker": {"kind": "person", "person_id": "ou_fen", "display_name": "Fen Zhao", "reconciled": true},
      "attribution_confidence": 0.86,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    },
    {
      "segment_id": "s014",
      "started_at": "2026-09-02T14:09:20Z",
      "ended_at": "2026-09-02T14:10:00Z",
      "text": "That is everything on the checklist, thank you all.",
      "speaker": {"kind": "person", "person_id": "ou_ada", "display_name": "Ada Chen", "reconciled": true},
      "attribution_confidence": 0.94,
      "provenance": {"stage": "final_batch", "model": "batch-diarize-1"}
    }
