# Copy to ~/.config/teammem/memberkit.env  (chmod 600; dir chmod 700)
# your roster slug — ask the team-memory operator
MEMBERKIT_MEMBER=your-roster-slug
MEMBERKIT_INBOX_URL=git@forge.example:team/team-memory-inbox.git
